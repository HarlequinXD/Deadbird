/* DeadbirdStudio.exe resources: icon, version info, manifest. Having these (like any normal program)
   helps antivirus heuristics, which flag bare unsigned executables far more often. */
#include <winver.h>
#include <winuser.h>

1 ICON "deadbird.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "studio.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,3,0,0
PRODUCTVERSION  0,3,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "HarlequinXD"
            VALUE "FileDescription",  "Deadbird Studio - game and level editor"
            VALUE "FileVersion",      "0.3.0.0"
            VALUE "InternalName",     "DeadbirdStudio"
            VALUE "LegalCopyright",   "HarlequinXD"
            VALUE "OriginalFilename", "DeadbirdStudio.exe"
            VALUE "ProductName",      "Deadbird Studio"
            VALUE "ProductVersion",   "0.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
